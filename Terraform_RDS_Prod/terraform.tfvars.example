# Copy to terraform.tfvars and adjust. terraform.tfvars is gitignored.
# Note: there is NO db_password here — the master password is generated by RDS
# and stored in Secrets Manager (manage_master_user_password = true).

aws_region  = "ap-south-1"
project     = "learning-rds"
environment = "prod"

# Network
vpc_cidr             = "10.20.0.0/16"
private_subnet_cidrs = ["10.20.1.0/24", "10.20.2.0/24"]
# app_ingress_cidrs  = ["10.20.0.0/16"]   # optional extra allowed CIDRs (e.g. VPN)

# Instance / storage
instance_class        = "db.t3.medium"
allocated_storage     = 100
max_allocated_storage = 500
storage_type          = "gp3"

# HA & safety (prod defaults)
multi_az                = true
deletion_protection     = true
skip_final_snapshot     = false
backup_retention_period = 30
